{#
 # Content of one cell of the criteria form: either a label, or a widget.
 # The surrounding <td> is opened by the caller (the form template, or AutoReport::startColumn()
 # on the legacy path).
 #}
{% set label = label ?? '' %}
{% set field = field ?? '' %}
{% set suffix = suffix ?? '' %}
{% set message = message ?? '' %}
{% if label is not empty %}{{ label }}&nbsp;:{% endif %}
{% if message is not empty %}
    <div class="alert alert-danger center">{{ message }}</div>
{% endif %}
{# Widget built by a GLPI core helper with 'display' => false (Dropdown::show(),
 # Html::showDateField(), Html::input()...): the helper escapes the values it embeds. #}
{{ field|raw }}
{% if suffix is not empty %}&nbsp;{{ suffix }}{% endif %}
