{# Markup of the legacy column API (AutoReport::startColumn() / endColumn() / closeColumn()): the
   criteria that still render themselves echo their content between two of these fragments #}
{% if open_row ?? false %}<tr class="tab_bg_1">{% endif %}
{% if open_cell ?? false %}<td>{% endif %}
{% if close_cell ?? false %}</td>{% endif %}
{% if (empty_cells ?? 0) > 0 %}{% for i in 1..empty_cells %}<td></td>{% endfor %}{% endif %}
{% if close_row ?? false %}</tr>{% endif %}
