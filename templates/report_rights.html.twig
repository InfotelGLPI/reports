{% if canedit %}
    <form action="{{ action }}" method="post">
{% endif %}

<br>
<table class="tab_cadre_fixehov">
    <tr><th colspan="2">{{ header }}</th></tr>
    {% for profile in profiles %}
        <tr class="tab_bg_2">
            <td>{{ profile.name }}&nbsp;: </td>
            <td>
                {{ profile.field|raw }}
                {% if not profile.canaccess %}{{ no_access }} *{% endif %}
            </td>
        </tr>
    {% endfor %}
    <tr class="tab_bg_2"><td colspan="2">* {{ footnote }}</td></tr>
    {% if canedit %}
        <tr class="tab_bg_1">
            <td colspan="2" class="center">
                <input type="hidden" name="report" value="{{ report }}">
                {{ call('Html::submit', [_x('button', 'Update'), {'name': 'update', 'class': 'btn btn-primary'}])|raw }}
            </td>
        </tr>
    {% endif %}
</table>

{% if canedit %}
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
{% endif %}
