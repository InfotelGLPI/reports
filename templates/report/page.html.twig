{#
 # Generic page of a report that does not go through AutoReport: an optional criteria form,
 # messages and data tables. Shared by the reports of report/ so that none of them writes HTML.
 #
 # form:            variables of @reports/autoreport/criteria_form.html.twig (optional)
 # messages:        [{type, text}] alerts shown above the tables (plain text)
 # tables:          variables of @reports/report/table.html.twig, one entry per table
 # massive:         {form_id, top, bottom} massive actions form wrapping the tables (optional);
 #                  top / bottom are toolbars built by Html::showMassiveActions(..., 'display' => false)
 # chart:           HTML of a core chart (Stat::displayPieGraph(..., false)) shown under the tables
 # footer_messages: [{type, text}] alerts shown under the tables (plain text)
 #}
{% set form = form ?? null %}
{% set massive = massive ?? null %}

{% if form is not null %}
    {{ include('@reports/autoreport/criteria_form.html.twig', form) }}
{% endif %}

{% for message in messages ?? [] %}
    <div class="alert alert-{{ message.type ?? 'danger' }} center">{{ message.text }}</div>
{% endfor %}

{% if massive is not null %}
    <form name="{{ massive.form_id }}" id="{{ massive.form_id }}" method="post"
          action="{{ path('/front/massiveaction.php') }}" enctype="multipart/form-data">
    {# Massive actions toolbar of the core (Html::showMassiveActions(..., 'display' => false)) #}
    {{ (massive.top ?? '')|raw }}
{% endif %}

{% for table in tables ?? [] %}
    {{ include('@reports/report/table.html.twig', table) }}
{% endfor %}

{% if massive is not null %}
    {# Massive actions toolbar of the core (Html::showMassiveActions(..., 'display' => false)) #}
    {{ (massive.bottom ?? '')|raw }}
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
{% endif %}

{% if chart ?? '' is not empty %}
    <div class="center">
        {# Chart widget of the core (Stat::displayPieGraph(..., false)) #}
        {{ chart|raw }}
    </div>
{% endif %}

{% for message in footer_messages ?? [] %}
    <div class="alert alert-{{ message.type ?? 'danger' }} center">{{ message.text }}</div>
{% endfor %}
